# ---------------------------------------------------------------- Supabase
# Create the project in the EU (Frankfurt / eu-central-1) — GDPR data residency
# is a design constraint, not a preference. See plan §3.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler URI (port 5432). Migrations and policy application only —
# never used at runtime, where we go through PostgREST so RLS applies.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------------------------- the model
# ONE of these two is enough. They fill the same schema and nothing else in the
# app calls a model, so whichever you set, the ICP analysis works.
#
# Claude is preferred when both are present — it handles a long page dump and a
# fifteen-field schema more reliably. A few euro a month at MVP volume.
ANTHROPIC_API_KEY=
#
# Gemini is the free-tier option, and the faster way to try the product without
# paying anyone: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Defaults to gemini-3.6-flash. Only set this to move to another model.
GEMINI_MODEL=

# --------------------------------------------------------------- encryption
# 32 random bytes, base64. Encrypts Gmail refresh tokens at rest.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# ------------------------------------------------------------- Gmail OAuth
# Scopes requested: gmail.send + gmail.compose. Both are SENSITIVE, not
# restricted — so no CASA audit ($540-1000) and no annual recertification.
# Unverified apps are capped at 100 test users, which is fine for the MVP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------- enrichment providers
# ALL OPTIONAL. The app boots and works with none of these set; each adapter
# reports itself unavailable and the waterfall skips it.
#
# Phase 2b spike fills these in and records real hit rates. Note Apollo is
# absent on purpose: its free and Basic plans include no API access at all,
# and API starts at the ~$745/mo Organization tier.
HUNTER_API_KEY=
PDL_API_KEY=
PROSPEO_API_KEY=
LEADMAGIC_API_KEY=
CORESIGNAL_API_KEY=
BRAVE_SEARCH_API_KEY=

# Mailbox verification. Free tier: 600/month, no card, at
# https://www.reoon.com/email-verifier/ -- without it a generated address stays
# `pattern` and is never sendable, which caps outreach at harvested role
# addresses.
REOON_API_KEY=
# `power` probes the individual inbox and is the only mode that can confirm a
# generated address. `quick` only checks the domain, so it marks every address
# at a live domain valid -- useful for spamtrap screening, useless for guessing.
REOON_MODE=power

# Apify needs both: a token AND a chosen marketplace actor. The actor is left
# to you on purpose — actor quality shifts, and picking one would pre-empt the
# judgement the Phase 2b spike exists to make.
APIFY_TOKEN=
APIFY_PEOPLE_ACTOR=
